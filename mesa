#!/usr/bin/env bash
# Mesa Digital - Script operacional simples
# Uso: ./mesa {start|stop|restart|status|logs}

set -euo pipefail

PROJECT_ROOT="/opt/mesa-digital"
BACKEND_DIR="$PROJECT_ROOT/backend"
FRONTEND_DIR="$PROJECT_ROOT/frontend"
PID_DIR="/tmp/mesa-digital"
LOG_DIR="$PROJECT_ROOT/logs"
POSTGRES_PORT=55432
BACKEND_PORT=3002
FRONTEND_PORT=3001
PNPM_CMD="/opt/mesa-digital/.tools/node/lib/node_modules/corepack/shims/pnpm"

mkdir -p "$PID_DIR" "$LOG_DIR"

# Cores para output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log_info() { echo -e "${GREEN}[INFO]${NC} $*"; }
log_warn() { echo -e "${YELLOW}[AVISO]${NC} $*"; }
log_error() { echo -e "${RED}[ERRO]${NC} $*"; }

# Verifica se processo existe
pid_exists() {
    local pid="$1"
    [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

# Lê PID do arquivo
read_pid() {
    local file="$1"
    [[ -f "$file" ]] && cat "$file" 2>/dev/null || echo ""
}

# Verifica se porta está em uso
port_in_use() {
    local port="$1"
    ss -ltn 2>/dev/null | grep -q ":$port " || lsof -i ":$port" -sTCP:LISTEN >/dev/null 2>&1
}

# Para um processo de forma segura, sempre retorna 0
safe_kill() {
    local pid="$1"
    local signal="${2:-TERM}"
    kill -"$signal" "$pid" 2>/dev/null || true
    return 0
}

stop_process() {
    local name="$1"
    local pid_file="$PID_DIR/${name}.pid"
    local pid=$(cat "$pid_file" 2>/dev/null || echo "")
    
    if pid_exists "$pid"; then
        log_info "Parando $name (PID: $pid)..."
        kill "$pid" 2>/dev/null || true
        local tentativas=0
        while pid_exists "$pid" && [[ $tentativas -lt 10 ]]; do
            sleep 0.5
            tentativas=$((tentativas + 1))
        done
        if pid_exists "$pid"; then
            log_warn "Forçando término de $name (PID: $pid)"
            kill -9 "$pid" 2>/dev/null || true
        fi
    else
        log_warn "$name não estava rodando"
    fi
    rm -f "$pid_file"
    return 0
}

# Inicializa PostgreSQL
start_postgres() {
    if port_in_use "$POSTGRES_PORT"; then
        log_info "PostgreSQL já rodando na porta $POSTGRES_PORT"
        return 0
    fi
    
    log_info "Iniciando PostgreSQL na porta $POSTGRES_PORT..."
    # Assumindo PostgreSQL instalado localmente via systemd ou similar
    if systemctl is-active --quiet postgresql 2>/dev/null; then
        log_info "PostgreSQL já ativo via systemd"
        return 0
    fi
    
    # Tenta iniciar via systemd (requer sudo)
    if sudo systemctl start postgresql 2>/dev/null; then
        sleep 2
        if port_in_use "$POSTGRES_PORT"; then
            log_info "PostgreSQL iniciado com sucesso"
            return 0
        fi
    fi
    
    log_error "Não foi possível iniciar PostgreSQL. Verifique se está instalado e configurado na porta $POSTGRES_PORT"
    return 1
}

# Inicializa Backend
start_backend() {
    local pid=$(read_pid "$PID_DIR/backend.pid")
    if pid_exists "$pid" && port_in_use "$BACKEND_PORT"; then
        log_info "Backend já rodando (PID: $pid, porta $BACKEND_PORT)"
        return 0
    fi
    
    log_info "Iniciando Backend na porta $BACKEND_PORT..."
    cd "$BACKEND_DIR"
    
    # Verifica se build existe
    if [[ ! -f "dist/main.js" ]]; then
        log_info "Build não encontrado, compilando..."
        pnpm build > "$LOG_DIR/backend-build.log" 2>&1 || {
            log_error "Falha no build do backend. Verifique $LOG_DIR/backend-build.log"
            return 1
        }
    fi
    
    # Inicia backend
    PORT="$BACKEND_PORT" nohup node --env-file="../.env" dist/main.js \
        > "$LOG_DIR/backend.log" 2>&1 &
    local pid=$!
    echo "$pid" > "$PID_DIR/backend.pid"
    
    # Aguarda subir
    local tentativas=0
    while [[ $tentativas -lt 30 ]]; do
        if port_in_use "$BACKEND_PORT"; then
            log_info "Backend iniciado (PID: $pid, porta $BACKEND_PORT)"
            return 0
        fi
        sleep 1
        ((tentativas++))
    done
    
    log_error "Backend não subiu a tempo. Verifique $LOG_DIR/backend.log"
    return 1
}

# Inicia frontend
start_frontend() {
    local pid=$(read_pid "$PID_DIR/frontend.pid")
    # Se já tem PID mas a porta não está em uso, limpa o PID antigo
    if [[ -n "$pid" ]] && ! port_in_use "$FRONTEND_PORT"; then
        log_warn "PID anterior ($pid) inválido, limpando..."
        rm -f "$PID_DIR/frontend.pid"
        pid=""
    fi
    if pid_exists "$pid" && port_in_use "$FRONTEND_PORT"; then
        log_info "Frontend já rodando (PID: $pid, porta $FRONTEND_PORT)"
        return 0
    fi
    
    # Garante que a porta está livre antes de iniciar
    if port_in_use "$FRONTEND_PORT"; then
        log_warn "Porta $FRONTEND_PORT em uso, tentando liberar..."
        local existing_pid=$(ss -ltnp 2>/dev/null | grep ":$FRONTEND_PORT " | grep -oP 'pid=\K[0-9]+' | head -1)
        if [[ -n "$existing_pid" ]]; then
            kill -9 "$existing_pid" 2>/dev/null || true
            sleep 1
        fi
    fi
    
        log_info "Iniciando Frontend na porta $FRONTEND_PORT..."
        cd "$FRONTEND_DIR"
        
        # Verifica se build existe
        if [[ ! -d ".next" ]]; then
            log_info "Build não encontrado, compilando..."
            "$PNPM_CMD" build > "$LOG_DIR/frontend-build.log" 2>&1 || {
                log_error "Falha no build do frontend. Verifique $LOG_DIR/frontend-build.log"
                return 1
            }
        fi
        
        PORT="$FRONTEND_PORT" NEXT_PUBLIC_API_URL="http://localhost:$BACKEND_PORT" \
            nohup setsid "$PROJECT_ROOT/.tools/node/bin/node" \
            "$FRONTEND_DIR/node_modules/next/dist/bin/next" start \
            > "$LOG_DIR/frontend.log" 2>&1 < /dev/null &
        local pid=$!
        echo "$pid" > "$PID_DIR/frontend.pid"
        
        # Aguarda subir
        local tentativas=0
        while [[ $tentativas -lt 30 ]]; do
            if port_in_use "$FRONTEND_PORT"; then
                log_info "Frontend iniciado (PID: $pid, porta $FRONTEND_PORT)"
                return 0
            fi
            sleep 1
            ((tentativas++))
        done
        
        log_error "Frontend não subiu a tempo. Verifique $LOG_DIR/frontend.log"
        stop_process "frontend"
        return 1
}

# ===== COMANDOS =====

cmd_start() {
    log_info "=== Iniciando Mesa Digital ==="
    
    start_postgres || return 1
    start_backend || return 1
    start_frontend || return 1
    
    log_info "=== Mesa Digital iniciado com sucesso ==="
    log_info "Backend:  http://localhost:$BACKEND_PORT"
    log_info "Frontend: http://localhost:$FRONTEND_PORT"
    return 0
}

cmd_stop() {
    log_info "=== Parando Mesa Digital ==="
    stop_process "frontend"
    stop_process "backend"
    log_info "=== Mesa Digital parado ==="
    return 0
}

cmd_restart() {
    cmd_stop
    sleep 2
    cmd_start
}

cmd_status() {
    echo "=== Status Mesa Digital ==="
    
    # PostgreSQL
    if port_in_use "$POSTGRES_PORT"; then
        echo -e "PostgreSQL: ${GREEN}ON${NC} (porta $POSTGRES_PORT)"
    else
        echo -e "PostgreSQL: ${RED}OFF${NC} (porta $POSTGRES_PORT)"
    fi
    
    # Backend
    if pid_exists "$(read_pid "$PID_DIR/backend.pid")" && port_in_use "$BACKEND_PORT"; then
        echo -e "Backend:    ${GREEN}ON${NC}  (PID: $(read_pid "$PID_DIR/backend.pid"), porta $BACKEND_PORT)"
    else
        echo -e "Backend:    ${RED}OFF${NC} (porta $BACKEND_PORT)"
    fi
    
    # Frontend
    if pid_exists "$(read_pid "$PID_DIR/frontend.pid")" && port_in_use "$FRONTEND_PORT"; then
        echo -e "Frontend:   ${GREEN}ON${NC}  (PID: $(read_pid "$PID_DIR/frontend.pid"), porta $FRONTEND_PORT)"
    else
        echo -e "Frontend:   ${RED}OFF${NC} (porta $FRONTEND_PORT)"
    fi
}

cmd_logs() {
    local component="${1:-all}"
    case "$component" in
        backend)
            tail -f "$LOG_DIR/backend.log"
            ;;
        frontend)
            tail -f "$LOG_DIR/frontend.log"
            ;;
        build)
            tail -f "$LOG_DIR/backend-build.log" "$LOG_DIR/frontend-build.log" 2>/dev/null
            ;;
        *)
            tail -f "$LOG_DIR/backend.log" "$LOG_DIR/frontend.log" 2>/dev/null
            ;;
    esac
}

# ===== MAIN =====

case "${1:-}" in
    start)
        cmd_start
        ;;
    stop)
        cmd_stop
        ;;
    restart)
        cmd_restart
        ;;
    status)
        cmd_status
        ;;
    logs)
        cmd_logs "${2:-all}"
        ;;
    *)
        echo "Uso: ./mesa {start|stop|restart|status|logs [backend|frontend|build|all]}"
        exit 1
        ;;
esac
